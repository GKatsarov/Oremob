{%- comment -%}
  Renders the country picker for the localization form

  Accepts:
    - localPosition: pass in the position in which the form is coming up to create specific IDs
{%- endcomment -%}

<div class="disclosure" style="font-family:NeueHaasDisplay-Black,serif;">
  <button
    type="button"
    class="disclosure__button localization-form__select localization-selector link link--text caption-large bg-[#202020]"
    aria-expanded="false"
    aria-controls="{{ localPosition }}List"
    aria-describedby="{{ localPosition }}Label"
    onclick="toggleDropdown('{{ localPosition }}List', this)"
  >
    <span class="pr-24 text-span text-3xl">
      {{- localization.country.currency.iso_code }} | {{ localization.country.name -}}
    </span>

    <!-- Arrow Forward (default) -->
    <img 
      src="{{ 'arrow_forward.svg' | asset_url }}" 
      class="w-[3rem] h-[3rem] arrow-forward" 
      width="3rem" 
      height="3rem" 
      alt="Forward"
    />
    <!-- Arrow Up (hidden initially) -->
    <img 
      src="{{ 'arrow_forward_up.svg' | asset_url }}" 
      class="w-[3rem] h-[3rem] arrow-up hidden" 
      width="3rem" 
      height="3rem" 
      alt="Up"
    />
  </button>

  <div class="country-selection-container">
  
    <!-- Dropdown list -->
    <div class="disclosure__list-wrapper space-y-4" style="display: none;" id="{{ localPosition }}List">
      <!-- Sort countries alphabetically by name -->
      {%- assign sorted_countries = localization.available_countries | sort: 'name' -%}

      <span class="country-selection-title justify-center text-[2rem] lg:text-[3rem] lg:ml-[3.5rem] ml-0">Choose your country or region</span>
      
      <ul role="list" class="disclosure__list list-unstyled">
        {%- for country in sorted_countries -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large text-[20px] focus-inset{% if country.iso_code == localization.country.iso_code %} disclosure__link--active{% endif %}"
              href="#"
              {% if country.iso_code == localization.country.iso_code %}
                aria-current="true"
              {% endif %}
              data-value="{{ country.iso_code }}"
            >
              <span class="localization-form__currency">
                {{- country.currency.iso_code }} -
              </span>
              {{ country.name }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>  
</div>

<input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">

<script>
  function toggleDropdown(dropdownId, button) {
    const dropdown = document.getElementById(dropdownId);
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    const currentDisplay = window.getComputedStyle(dropdown).display;
    const arrowForward = button.querySelector('.arrow-forward');
    const arrowUp = button.querySelector('.arrow-up');
    const textSpan = button.querySelector('.text-span');

    if (currentDisplay === 'none') {
      dropdown.style.display = 'block';
      arrowForward.classList.add('hidden');
      arrowUp.classList.remove('hidden');
      textSpan.classList.add('active-text');
    } else {
      dropdown.style.display = 'none';
      arrowForward.classList.remove('hidden');
      arrowUp.classList.add('hidden');
      textSpan.classList.remove('active-text');
    }
  
    button.setAttribute('aria-expanded', !isExpanded);
    
    console.log("New display: ", dropdown.style.display);
  }
</script>
