{%- liquid
  assign container_class = 'bg-primary text-contrast'
  assign input_class = 'focus:border-primary/20'
-%}

{%- if section.settings.enable_sticky_header -%}
  <sticky-header client:idle>
{%- else -%}
  <div client:idle>
{%- endif -%}
  
  <!-- Header Section with backdrop blur -->
  <header id="shopify-section-header" role="banner" class="{{ container_class }} h-nav w-full leading-none bg-primary bg-opacity-50 px-4 flex justify-between items-center mb-[1.25rem] md:px-8 lg:px-12 text-xl md:text-2xl lg:text-3xl"
          style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
    
    <!-- Left-aligned Logo (hidden on small screens) -->
    <div class="flex items-center w-full mt-[26px] lg:w-auto justify-start sm-max:hidden">
      <a href="{{ routes.root_url }}" class="flex items-center">
        <img 
          src="{{ 'logo.png' | asset_url }}" 
          class="md:h-[68px] w-[50px] md:w-[76px]" 
          width="50" 
          height="44" 
          alt="Logo" 
        />
      </a>
    </div>

    <!-- Shopping Button -->
    <div class="flex items-center w-full justify-start md:hidden mt-[24px]">
      <a href="{{ routes.cart_url }}" class="flex items-center justify-between rounded-xl bg-gray-300 text-white p-1 w-[100px] h-[40px]" id="cart-icon-bubble">
        <div class="flex items-center justify-center w-1/2 h-full bg-[#C3C3C3] rounded-l-xl">
          <img src="{{ 'shopping_basket.svg' | asset_url }}" alt="Cart" class="w-12 h-12" loading="lazy" width="24" height="24" />
        </div>
        
        <div class="flex items-center justify-center w-1/2 h-full bg-black rounded-r-xl">
          <span class="text-customGreen text-3xl font-bold">{{ cart.item_count }}</span>
        </div>
      </a>
    </div>

    <!-- Centered Logo -->
    <div class="flex items-center w-full mt-[24px] lg:w-auto justify-center md:hidden">
      <a href="{{ routes.root_url }}" class="flex items-center">
        <img 
          src="{{ 'logo.png' | asset_url }}" 
          class="md:h-[68px] w-[50px] md:w-[76px]" 
          width="50" 
          height="44" 
          alt="Logo" 
        />
      </a>
    </div>

    <div class="flex items-center w-full mt-[24px] lg:w-auto justify-center sm-max:hidden">
      <a href="/" class="relative" style="display: block; position: relative;">
        <img src="{{ 'overlay_shop.svg' | asset_url }}" alt="" class="motion-reduce" loading="lazy" width="175" height="104">
      </a>
    </div>

    <!-- Right-aligned Shopping Button -->
    <div class="flex items-center justify-end mt-[30px] w-full space-x-4 lg:w-auto">
      
      <a href="{{ routes.cart_url }}" class="flex items-center justify-between rounded-xl bg-gray-300 text-white p-1 w-[100px] h-[40px] sm-max:hidden" id="cart-icon-bubble">
        <div class="flex items-center justify-center w-1/2 h-full bg-[#C3C3C3] rounded-l-xl">
          <img src="{{ 'shopping_basket.svg' | asset_url }}" alt="Cart" class="w-12 h-12" loading="lazy" width="24" height="24" />
        </div>
        
        <div class="flex items-center justify-center w-1/2 h-full bg-black rounded-r-xl">
          <span class="text-customGreen text-3xl font-bold">{{ cart.item_count }}</span>
        </div>
      </a>

      <!-- Dropdown Menu with Full-screen overlay and dynamic content -->
      <div class="relative inline-block">
        <!-- Button to trigger the dropdown -->
        <button id="dropdownRadioButton" class="group rounded-xl md:px-4 md:py-[10px] text-center md:inline-flex items-center md:bg-black" type="button">

          <!-- Show this when screen is bigger -->
          <div class="items-center sm-max:hidden">
            <input style="top:-1px;" id="default-radio-current" disabled type="radio" value="" name="default-radio" class="relative cursor-pointer w-8 h-8 text-white bg-customGreen group-hover:text-customGreen group-focus:ring-0 ">
            <label for="default-radio-current" class="cursor-pointer ml-2 mr-4 text-[18px] font-medium group-hover:text-customGreen text-white leading-[2rem]">
              {{ section.settings.menu.links[0].title }}
            </label>
          </div>

          <!-- Show this when screen is smaller -->
          <div class="md:hidden" id="default-radio-current">
            <img src="{{ 'menu.svg' | asset_url }}" alt="Menu" class="w-20 h-20" loading="lazy" width="80" height="80" />
          </div>

        </button>

        <!-- Full-screen background overlay with blur effect -->
        <div id="dropdownOverlay" class="fixed inset-0 bg-[#D9D9D9] bg-opacity-10 backdrop-blur-sm hidden z-10" style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);"></div>

        <!-- Dropdown menu (aligned below the button with dynamic width) -->
        <div id="dropdownDefaultRadio" class="absolute right-0 z-50 bg-black rounded-[10px] shadow-lg p-8 hidden mt-[2.5rem]" style="min-width: 320px; max-width: 500px;">
          <div class="flex justify-end mb-2">
            <button id="closeDropdownButton">
              <img src="{{ 'close_small.svg' | asset_url }}" alt="Close" class="text-customGreen" width="36" height="36">
            </button>
          </div>

          <!-- Dynamic Menu Options from Liquid -->
          <ul class="space-y-6 text-white">
            {%- for link in section.settings.menu.links -%}
              <li class="cursor-pointer">
                <a href="{{ link.url }}" class="block text-4xl font-bold text-white hover:text-customGreen">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}

            {%liquid
              assign loginTitle = 'customer.account_fallback' | t | upcase
              if customer
                assign loginTitle = 'customer.login_page.title' | t | upcase
              endif
            %}

            <!-- Login Link -->
            <li class="cursor-pointer">
              <a href="{{ routes.account_login_url }}" class="block text-4xl font-bold text-white hover:text-customGreen">
                {{ loginTitle }}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </header>
{%- if section.settings.enable_sticky_header -%}
  </sticky-header>
{%- else -%}
  </div>
{%- endif -%}

<!-- JavaScript for Dropdown and Overlay Management -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownButton = document.getElementById('dropdownRadioButton');
    const dropdownMenu = document.getElementById('dropdownDefaultRadio');
    const dropdownOverlay = document.getElementById('dropdownOverlay');
    const closeDropdownButton = document.getElementById('closeDropdownButton');
  
    // Function to toggle the dropdown menu visibility
    function toggleDropdown() {
      const isMenuVisible = !dropdownMenu.classList.contains('hidden');
  
      if (isMenuVisible) {
        // If the menu is visible, hide it
        dropdownMenu.classList.add('hidden');
        dropdownOverlay.classList.add('hidden');
      } else {
        // If the menu is hidden, show it
        dropdownMenu.classList.remove('hidden');
        dropdownOverlay.classList.remove('hidden');
      }
    }
  
    // Event listener for toggling the dropdown menu
    dropdownButton.addEventListener('click', toggleDropdown);
  
    // Close the dropdown when clicking the close button or overlay
    closeDropdownButton.addEventListener('click', function() {
      dropdownMenu.classList.add('hidden');
      dropdownOverlay.classList.add('hidden');
    });
    dropdownOverlay.addEventListener('click', function() {
      dropdownMenu.classList.add('hidden');
      dropdownOverlay.classList.add('hidden');
    });
  });  
</script>

<!-- JSON-LD Schema for SEO -->
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

<script> 
var ss = {{ section.settings | json }};
console.log("Header Section Loaded", ss);
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Primary navigation"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "default": true,
      "label": "Enable sticky header",
      "info": "Header shows on the screen as customers scroll up."
    }
  ]
}
{% endschema %}
