{% comment %}
  Renders social icons.
  Accepts:
  - class: {String} a class to be added to the <ul> element (optional).

  Usage:
  {% render 'social-icons',
    class: 'my-class'
  %}
{% endcomment %}

<ul class="list-unstyled list-social{% if class %} {{ class}}{% endif %}" role="list">
  {%- if settings.social_facebook_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_facebook_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.facebook' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_instagram_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.instagram' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_youtube_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.youtube' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_tiktok_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.tiktok' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_twitter_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_twitter_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.twitter' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_pinterest_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.pinterest' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_snapchat_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_snapchat_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.snapchat' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_tumblr_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_tumblr_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.tumblr' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_vimeo_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_vimeo_link }}" class="list-social__link">
        {%- render 'icon-radio' -%}
        <span>{{ 'general.social.links.vimeo' | t }}</span>
      </a>
    </li>
  {%- endif -%}

  {%- if section.settings.show_policy -%}
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <li class="list-social__item">
            <a href="{{ policy.url }}" class="list-social__link">
              {%- render 'icon-radio' -%}
              <span>{{ policy.title }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
  {%- endif -%}

  <div class="disclosure">
    <button
      type="button"
      class="disclosure__button localization-form__select localization-selector link link--text caption-large"
      aria-expanded="false">
      <span>Legal</span>
      {% render 'icon-caret' %}
    </button>
  <div class="disclosure__list-wrapper country-selector" hidden>
    <ul id="FooterCountryList" role="list" class="disclosure__list list-unstyled">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset"
              href="{{ policy.url }}">
              <span>
                <span>{{ policy.title }}</span>
              </span>
            </a>
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

</ul>
